{
	"name": "@zaplink/db",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"devDependencies": {
		"drizzle-kit": "^0.31.11",
		"@types/ws": "^8.18.1",
		"tsdown": "catalog:"
	},
	"peerDependencies": {
		"typescript": "^5.9.3 || ^6 || ^7"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.3",
		"@neondatabase/serverless": "^1.1.0",
		"ws": "^8.22.0",
		"dotenv": "catalog:",
		"zod": "catalog:"
	}
}
